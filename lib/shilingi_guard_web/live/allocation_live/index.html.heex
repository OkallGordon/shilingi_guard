<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <.header>
        Your Allocations
        <:subtitle>
          Decide what your money is meant for before you spend it.
        </:subtitle>
      </.header>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <section class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-zinc-900">
          Create an allocation
        </h2>

        <p class="mt-2 text-sm text-zinc-600">
          Give your money a purpose and assign an amount to it.
        </p>

        <.form
          for={@form}
          id="allocation_form"
          phx-submit="save"
          phx-change="validate"
          class="mt-6 space-y-5"
        >
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            placeholder="e.g. Food"
            required
          />

          <.input
            field={@form[:amount]}
            type="number"
            label="Amount (KSh)"
            step="0.01"
            min="0.01"
            placeholder="e.g. 9000"
            required
          />

          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={[
              {"Spending", "spending"},
              {"Protected", "protected"}
            ]}
            prompt="Choose a type"
            required
          />

          <.button
            phx-disable-with="Saving..."
            class="btn btn-primary w-full"
          >
            Create allocation
          </.button>
        </.form>
      </section>

      <section class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-zinc-900">
          Your allocations
        </h2>

        <p class="mt-2 text-sm text-zinc-600">
          These are the purposes you've assigned to your money.
        </p>

        <div class="mt-6 space-y-4">
          <%= if @allocations == [] do %>
            <div class="rounded-lg bg-zinc-50 p-4 text-sm text-zinc-600">
              You don't have any allocations yet.
            </div>
          <% else %>
            <%= for allocation <- @allocations do %>
              <div class="rounded-lg border border-zinc-200 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="font-semibold text-zinc-900">
                      <%= allocation.name %>
                    </h3>

                    <p class="mt-1 text-sm text-zinc-600">
                      <%= String.capitalize(allocation.type) %>
                    </p>
                  </div>

                  <div class="text-right">
                    <p class="text-lg font-bold text-zinc-900">
                      KSh <%= Decimal.to_string(allocation.amount) %>
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>