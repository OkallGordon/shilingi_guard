<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <.header>
        Your Allocations
        <:subtitle>
          Decide what your money is meant for before you spend it.
        </:subtitle>
      </.header>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <section class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
        <h2 class="text-xl font-semibold">
          <%= if @editing_allocation do %>
            Edit allocation
          <% else %>
            Create an allocation
          <% end %>
        </h2>

        <p class="mt-2 text-sm text-base-content/70">
          <%= if @editing_allocation do %>
            Update the purpose, amount, or type of this allocation.
          <% else %>
            Give your money a purpose and assign an amount to it.
          <% end %>
        </p>

        <.form
          for={@form}
          id="allocation_form"
          phx-change="validate"
          phx-submit="save"
          class="mt-6 space-y-4"
        >
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            placeholder="e.g. Food"
            required
          />

          <.input
            field={@form[:amount]}
            type="number"
            label="Amount (KSh)"
            step="0.01"
            min="0.01"
            placeholder="e.g. 9000"
            required
          />

          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={[
              {"Spending", "spending"},
              {"Protected", "protected"}
            ]}
            prompt="Choose a type"
            required
          />

          <div class="flex gap-3">
            <.button
              phx-disable-with="Saving..."
              class="btn btn-primary flex-1"
            >
              <%= if @editing_allocation do %>
                Save changes
              <% else %>
                Create allocation
              <% end %>
            </.button>

            <%= if @editing_allocation do %>
              <button
                type="button"
                phx-click="cancel_edit"
                class="btn btn-ghost"
              >
                Cancel
              </button>
            <% end %>
          </div>
        </.form>
      </section>

      <section class="rounded-2xl border border-base-300 bg-base-100 p-6 shadow-sm">
        <h2 class="text-xl font-semibold">Your allocations</h2>

        <p class="mt-2 text-sm text-base-content/70">
          These are the purposes you've assigned to your money.
        </p>

        <div class="mt-6 space-y-4">
          <%= if @allocations == [] do %>
            <div class="rounded-xl border border-dashed border-base-300 p-6 text-center">
              <p class="font-medium">You don't have any allocations yet.</p>
              <p class="mt-1 text-sm text-base-content/60">
                Create your first allocation to start giving your money a purpose.
              </p>
            </div>
          <% else %>
            <%= for allocation <- @allocations do %>
              <div class="rounded-xl border border-base-300 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="font-semibold">{allocation.name}</h3>

                    <p class="mt-1 text-sm text-base-content/60">
                      {String.capitalize(allocation.type)}
                    </p>

                    <p class="mt-2 text-lg font-semibold">
                      KSh {Decimal.to_string(allocation.amount)}
                    </p>
                  </div>

                  <div class="flex gap-2">
                    <button
                      type="button"
                      phx-click="edit"
                      phx-value-id={allocation.id}
                      class="btn btn-sm btn-ghost"
                    >
                      Edit
                    </button>

                    <button
                      type="button"
                      phx-click="delete"
                      phx-value-id={allocation.id}
                      data-confirm="Are you sure you want to delete this allocation?"
                      class="btn btn-sm btn-error btn-outline"
                    >
                      Delete
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>
