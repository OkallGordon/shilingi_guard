<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8">
      <.header>
        Spending Rules
        <:subtitle>
          Control how quickly you can use money from each allocation.
        </:subtitle>
      </.header>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <section class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-zinc-900">
          <%= if @editing_rule do %>
            Edit spending rule
          <% else %>
            Add a spending rule
          <% end %>
        </h2>

        <p class="mt-2 text-sm text-zinc-600">
          <%= if @editing_rule do %>
            Update the period or limit for this spending rule.
          <% else %>
            Set a daily, weekly, or monthly limit for an allocation.
          <% end %>
        </p>

        <.form
          for={@form}
          id="spending_rule_form"
          phx-submit="save"
          phx-change="validate"
          class="mt-6 space-y-5"
        >
          <.input
            field={@form[:allocation_id]}
            type="select"
            label="Allocation"
            options={
              Enum.map(@allocations, fn allocation ->
                {"#{allocation.name} — KSh #{Decimal.to_string(allocation.amount)}",
                 allocation.id}
              end)
            }
            prompt="Choose an allocation"
            disabled={@editing_rule != nil}
            required
          />

          <.input
            field={@form[:period]}
            type="select"
            label="Period"
            options={[
              {"Daily", "daily"},
              {"Weekly", "weekly"},
              {"Monthly", "monthly"}
            ]}
            required
          />

          <.input
            field={@form[:limit_amount]}
            type="number"
            label="Limit amount (KSh)"
            step="0.01"
            min="0.01"
            placeholder="e.g. 300"
            required
          />

          <div class="flex gap-3">
            <.button
              phx-disable-with="Saving..."
              class="btn btn-primary flex-1"
            >
              <%= if @editing_rule do %>
                Save changes
              <% else %>
                Add spending rule
              <% end %>
            </.button>

            <%= if @editing_rule do %>
              <button
                type="button"
                phx-click="cancel_edit"
                class="btn btn-ghost"
              >
                Cancel
              </button>
            <% end %>
          </div>
        </.form>
      </section>

      <section class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-zinc-900">
          Your spending rules
        </h2>

        <p class="mt-2 text-sm text-zinc-600">
          These rules control how quickly your allocated money can be spent.
        </p>

        <div class="mt-6 space-y-4">
          <%= if @spending_rules == [] do %>
            <div class="rounded-lg bg-zinc-50 p-4 text-sm text-zinc-600">
              You don't have any spending rules yet.
            </div>
          <% else %>
            <%= for rule <- @spending_rules do %>
              <div class="rounded-lg border border-zinc-200 p-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="font-semibold text-zinc-900">
                      {rule.allocation.name}
                    </h3>

                    <p class="mt-1 text-sm text-zinc-600">
                      {String.capitalize(rule.period)} limit
                    </p>
                  </div>

                  <div class="text-right">
                    <p class="text-lg font-bold text-zinc-900">
                      KSh {Decimal.to_string(rule.limit_amount)}
                    </p>

                    <p class="text-xs text-zinc-500">
                      per {rule.period}
                    </p>
                  </div>
                </div>

                <div class="mt-4 flex gap-2">
                  <button
                    type="button"
                    phx-click="edit"
                    phx-value-id={rule.id}
                    class="btn btn-sm btn-ghost flex-1"
                  >
                    Edit
                  </button>

                  <button
                    type="button"
                    phx-click="delete"
                    phx-value-id={rule.id}
                    data-confirm="Are you sure you want to delete this spending rule?"
                    class="btn btn-sm btn-error btn-outline flex-1"
                  >
                    Delete
                  </button>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>
