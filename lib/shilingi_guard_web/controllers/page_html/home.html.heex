<div class="min-h-screen bg-base-200">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        Shilingi Guard
      </p>

      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Take control of your money.
      </h1>

      <p class="mt-4 max-w-2xl text-lg text-base-content/70">
        Allocate your income, set spending limits, and protect the money
        you've already committed to your priorities.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-base-100 p-6 shadow-sm">
        <p class="text-sm text-base-content/60">Today's spendable money</p>
        <p class="mt-3 text-3xl font-bold">KSh 300</p>
        <p class="mt-2 text-sm text-base-content/60">
          Your daily food allowance
        </p>
      </div>

      <div class="rounded-2xl bg-base-100 p-6 shadow-sm">
        <p class="text-sm text-base-content/60">Monthly income</p>
        <p class="mt-3 text-3xl font-bold">KSh 30,000</p>
        <p class="mt-2 text-sm text-base-content/60">
          Ready to allocate
        </p>
      </div>

      <div class="rounded-2xl bg-base-100 p-6 shadow-sm">
        <p class="text-sm text-base-content/60">Protected money</p>
        <p class="mt-3 text-3xl font-bold">KSh 15,000</p>
        <p class="mt-2 text-sm text-base-content/60">
          Rent, savings and other commitments
        </p>
      </div>
    </div>

    <div class="mt-8 rounded-2xl bg-base-100 p-8 shadow-sm">
      <h2 class="text-2xl font-bold">Your spending rules</h2>

      <div class="mt-6 space-y-4">
        <div class="flex items-center justify-between border-b border-base-300 pb-4">
          <div>
            <p class="font-semibold">Food</p>
            <p class="text-sm text-base-content/60">Daily limit</p>
          </div>
          <p class="font-bold">KSh 300/day</p>
        </div>

        <div class="flex items-center justify-between border-b border-base-300 pb-4">
          <div>
            <p class="font-semibold">Transport</p>
            <p class="text-sm text-base-content/60">Daily limit</p>
          </div>
          <p class="font-bold">KSh 200/day</p>
        </div>

        <div class="flex items-center justify-between">
          <div>
            <p class="font-semibold">Shopping</p>
            <p class="text-sm text-base-content/60">Monthly limit</p>
          </div>
          <p class="font-bold">KSh 2,000/month</p>
        </div>
      </div>
    </div>
  </div>
</div>